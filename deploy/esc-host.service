[Unit]
Description=esc host (tunnel engine + web panel, plugin-based)
Documentation=https://github.com/EchoLab-Auto/echo-server-core
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# 与 esc-hub 一样用专用低权限用户；面板也是这个用户跑的（它只绑回环）
User=esc
Group=esc
ExecStart=/usr/local/bin/esc-host --config /etc/esc/host.toml
Restart=always
RestartSec=2s

# ── 沙箱加固 ─────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 证书与配置只读：/etc/esc 下不应有任何运行时写入
ReadOnlyPaths=/etc/esc

# 边缘路由插件（esc.edge-router）要监听 80 —— 非 root 绑 <1024 端口需要这个
# capability。只给这一项，不给其它任何特权（CapabilityBoundingSet 是上界；
# 不用 root、也不用给整个进程放开权限）。
#
# 不用 80 端口的话这两行可以去掉（把 [edge_router.config] listen 改成高位端口）。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# 映射表是**运行时状态**，放 /var/lib/esc（FHS 惯例），由 StateDirectory 自动
# 创建、赋予 User= 的属主，并隐含一条 ReadWritePaths —— 于是 ProtectSystem=strict
# 下这个目录仍然可写。
#
# 为什么不用 `ReadWritePaths=/etc/esc/mappings.toml`：原子写要**在同目录建临时
# 文件**再 rename，只放开单个文件不够，目录也必须可写。而把配置目录放开写权限
# 又违背 "配置只读、状态可写" 的分界。详见 docs/DEPLOY.md。
StateDirectory=esc
# 面板是宿主拉起的子进程，插件二进制必须可执行
# （放在 /usr/local/libexec/esc/ 下，属于系统路径，ProtectSystem=strict 下只读可执行）

# 引擎 + 面板子进程：常驻内存约 12 MB（hub 4 MB + 面板 8 MB）
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=esc-host

[Install]
WantedBy=multi-user.target
