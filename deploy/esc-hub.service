[Unit]
Description=esc hub (echo-server-core public gateway)
Documentation=https://github.com/EchoLab-Auto/echo-server-core
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# 以专用低权限用户运行，不给 root
User=esc
Group=esc
ExecStart=/usr/local/bin/esc hub --config /etc/esc/hub.toml
Restart=always
RestartSec=2s

# ── 沙箱加固 ─────────────────────────────────────────────────────────
# 只允许读配置文件与证书，其余文件系统不可见
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/esc

# 只需要约 30 MB 常驻内存
MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=esc-hub

[Install]
WantedBy=multi-user.target
