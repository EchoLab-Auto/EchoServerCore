{
  "name": "esc-panel-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "npm --prefix vendor/ui-frame install --no-audit --no-fund && npm --prefix vendor/ui-frame run build",
    "prebuild": "npm --prefix vendor/ui-frame run build",
    "build": "vite build && node scripts/embed.mjs",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node smoke.mjs"
  },
  "dependencies": {
    "@echolab-auto/ui-frame": "file:vendor/ui-frame",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
